    "Check if this app needs to keep Mac awake": {
      "localizations": {
        "zh-Hans": {
          "string": "检查此应用是否需要保持唤醒"
        },
        "zh-Hant": {
          "string": "檢查此應用是否需要保持喚醒"
        },
        "ja": {
          "string": "このアプリがMacの起動を維持する必要があるか確認"
        },
        "ko": {
          "string": "이 앱이 Mac을 깨어있게 할 필요가 있는지 확인"
        }
      }
    },
    "Close if you want Mac to sleep normally": {
      "localizations": {
        "zh-Hans": {
          "string": "如果希望 Mac 正常睡眠，请关闭"
        },
        "zh-Hant": {
          "string": "如果希望 Mac 正常睡眠，請關閉"
        },
        "ja": {
          "string": "Macを通常通りスリープさせる場合は閉じてください"
        },
        "ko": {
          "string": "Mac이 정상적으로 절전하도록 하려면 닫으세요"
        }
      }
    },
